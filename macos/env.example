# macOS (Apple silicon) settings for FirstLight CR. Copy the lines you need into
# the repository .env file. Paths must be absolute; no variable expansion.
CR_PYTHON=/Users/YOU/FirstLight_CR/.venv/bin/python

# Android SDK (cmdline-tools/latest, platform-tools, emulator,
# system-images;android-31;google_apis;arm64-v8a, build-tools, ndk)
CR_ANDROID_SDK=/Users/YOU/Library/Android/sdk
CR_ADB=/Users/YOU/Library/Android/sdk/platform-tools/adb
CR_EMULATOR=/Users/YOU/Library/Android/sdk/emulator/emulator
CR_BUILD_TOOLS=/Users/YOU/Library/Android/sdk/build-tools/37.0.0
CR_NDK_ROOT=/Users/YOU/Library/Android/sdk/ndk/27.3.13750724

# JDK 17 (Temurin tarball works without sudo)
CR_JAVA=/Users/YOU/apps/jdk-17/Contents/Home/bin/java
CR_KEYTOOL=/Users/YOU/apps/jdk-17/Contents/Home/bin/keytool
# Optional: a pre-downloaded Apktool 2.12.1 jar (SHA-256 is still verified)
CR_APKTOOL_JAR=

# Dedicated AVD (Android 12, Google APIs, arm64-v8a; adb root capable)
CR_AVD_NAME=firstlight-a12
CR_ADB_SERIAL=emulator-5554
CR_AVD_MEMORY_MB=3072
CR_AVD_CORES=4
CR_AVD_DATA_SIZE=12G
# host = Metal-backed GPU in a window; headless runs use swiftshader automatically
CR_EMULATOR_GPU=host
CR_EMULATOR_HEADLESS=false

CR_CONTROL_PORT=26789
CR_GUEST_CONTROL_PORT=26789
CR_INPUT_APK=/Users/YOU/FirstLight_CR/user-provided/nulls-royale.apk
CR_OUTPUT_APK=/Users/YOU/FirstLight_CR/build/cr-ai-offline.apk
CR_BUILD_ENGINE_COUNT=1
